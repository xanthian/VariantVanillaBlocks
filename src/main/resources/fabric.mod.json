{
  "schemaVersion": 1,
  "id": "variantvanillablocks",
  "version": "${version}",
  "name": "Variant Vanilla Blocks",
  "description": "Vanilla blocks recreated in all vanilla wood types",
  "authors": [
    "Xanthian"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.xanthian.variantvanillablocks.Initialise"
    ],
    "client": [
      "net.xanthian.variantvanillablocks.ClientInitialise"
    ],
    "fabric-datagen": [
      "net.xanthian.variantvanillablocks.DataGenerator"
    ]
  },
  "mixins": [
    "variantvanillablocks.mixins.json"
  ],
  "accessWidener": "variantvanillablocks.accesswidener",
  "depends": {
    "fabricloader": ">=0.15.0",
    "fabric": "*",
    "minecraft": ["1.21"],
    "java": ">=21"
  }
}